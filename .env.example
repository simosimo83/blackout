# Tutte le variabili sono opzionali: senza nessuna di queste l'app funziona,
# salvando email ed eventi in file JSONL dentro .data/

# Postgres per lista d'attesa ed eventi (Railway, Neon, Supabase...).
# Le tabelle blackout_waitlist e blackout_events vengono create al primo uso.
# DATABASE_URL=postgres://utente:password@host:5432/blackout

# Cartella dei file JSONL quando non si usa Postgres.
# BLACKOUT_DATA_DIR=.data

# "memory" per non scrivere nulla su disco (utile su filesystem in sola lettura).
# BLACKOUT_STORE=memory

# Provider analytics: elenco separato da virgole fra internal, plausible, ga, posthog, none.
# NEXT_PUBLIC_ANALYTICS_PROVIDER=internal

# Script del provider esterno, caricato nel layout.
# NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
# NEXT_PUBLIC_ANALYTICS_DOMAIN=blackout.example

# 1 per stampare ogni evento in console durante lo sviluppo.
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
